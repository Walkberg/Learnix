		{
			"name": "Summaries",
			"item": [
				{
					"name": "List Summaries for Course",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.items && jsonData.items.length > 0) {",
									"        pm.environment.set(\"summary_id\", jsonData.items[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
