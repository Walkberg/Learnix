generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  displayName  String
  email        String   @unique
  passwordHash String
  role         UserRole @default(FREE)
  createdAt    DateTime @default(now())
  courses      Course[]
}

enum UserRole {
  FREE
  PREMIUM
}

model Course {
  id         String      @id @default(cuid())
  author     User        @relation(fields: [authorId], references: [id])
  authorId   String
  title      String
  emoji      String?
  sourceText String
  createdAt  DateTime    @default(now())
  summaries  StudySheet[]
  quizzes    Quiz[]
  flashcards Flashcard[]
}

model StudySheet {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  title       String
  summary     Json
  summaryMd   String?
  keyPoints   Json
  generatedAt DateTime @default(now())
}

model Quiz {
  id            String   @id @default(cuid())
  course        Course   @relation(fields: [courseId], references: [id])
  courseId      String
  generatedFrom String?  
  params         Json
  questions      Json
  createdAt     DateTime @default(now())
}

model QuizAttempt {
  id         String   @id @default(cuid())
  quizId     String
  userId     String
  answers    Json
  score      Int
  submittedAt DateTime @default(now())
}

model Flashcard {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  prompt    String
  answer    String
  createdAt DateTime @default(now())
}
